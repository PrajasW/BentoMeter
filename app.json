{
  "expo": {
    "name": "BentoMeter",
    "slug": "bentometer",
    "scheme": "bentometer",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bentometer.app"
    },
    "android": {
      "package": "com.bentometer.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFD3E0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FFF8F2",
          "dark": {
            "backgroundColor": "#1C1A26"
          }
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "BentoMeter uses your photos so you can log meals you already snapped.",
          "cameraPermission": "BentoMeter uses the camera to photograph your meals for calorie estimates.",
          "microphonePermission": false
        }
      ],
      [
        "llama.rn",
        {
          "enableOpenCLAndHexagon": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class com.rnllama.** { *; }"
          }
        }
      ]
    ]
  }
}
